---
import Layout from '../layouts/Layout.astro';
import { env } from "cloudflare:workers";

const userId = Astro.cookies.get('user_session')?.value;
const db = env.DB;

if (!userId) {
  return Astro.redirect('/login');
}

let user = null;
let statusMessage = '';
let errorMessage = '';

try {
  user = await db.prepare("SELECT * FROM users WHERE id = ?").bind(userId).first();
} catch (e) {
  console.error(e);
}

if (!user) {
  Astro.cookies.delete('user_session', { path: '/' });
  return Astro.redirect('/login');
}

// Handle Form POST Actions
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action')?.toString();

    // 1. Answer a question
    if (action === 'answer_question') {
      const qId = data.get('question_id')?.toString();
      const answer = data.get('answer')?.toString().trim();
      if (qId && answer) {
        await db.prepare("UPDATE item_questions SET answer = ?, answered_at = CURRENT_TIMESTAMP WHERE id = ?").bind(answer, qId).run();
        statusMessage = 'Answer submitted successfully!';
      }
    }

    // 2. Mark item as SOLD
    if (action === 'mark_sold') {
      const itemId = data.get('item_id')?.toString();
      if (itemId) {
        await db.prepare("UPDATE items SET status = 'sold' WHERE id = ? AND seller_id = ?").bind(itemId, user.id).run();
        statusMessage = 'Item marked as SOLD!';
      }
    }

    // 3. Delete an item
    if (action === 'delete_item') {
      const itemId = data.get('item_id')?.toString();
      if (itemId) {
        await db.prepare("DELETE FROM item_questions WHERE item_id = ?").bind(itemId).run();
        await db.prepare("DELETE FROM item_interests WHERE item_id = ?").bind(itemId).run();
        if (user.role === 'admin') {
          await db.prepare("DELETE FROM items WHERE id = ?").bind(itemId).run();
        } else {
          await db.prepare("DELETE FROM items WHERE id = ? AND seller_id = ?").bind(itemId, user.id).run();
        }
        statusMessage = 'Listing deleted successfully.';
      }
    }
  } catch (err) {
    console.error(err);
    errorMessage = 'An error occurred while processing your request.';
  }
}

// Fetch items owned by this seller
const myItemsRes = await db.prepare("SELECT * FROM items WHERE seller_id = ? ORDER BY created_at DESC").bind(user.id).all();
const myItems = myItemsRes.results || [];

// Fetch buyer interest notifications for this seller's items
const interestsRes = await db.prepare(`
  SELECT item_interests.*, items.title as item_title, items.price as item_price,
         users.name as buyer_name, users.whatsapp_number as buyer_whatsapp, users.email as buyer_email
  FROM item_interests
  JOIN items ON item_interests.item_id = items.id
  JOIN users ON item_interests.buyer_id = users.id
  WHERE item_interests.seller_id = ? AND items.status = 'active'
  ORDER BY item_interests.created_at DESC
`).bind(user.id).all();
const buyerInterests = interestsRes.results || [];

// Fetch unanswered questions on this seller's items
const unansweredRes = await db.prepare(`
  SELECT item_questions.*, items.title as item_title, users.name as buyer_name
  FROM item_questions
  JOIN items ON item_questions.item_id = items.id
  JOIN users ON item_questions.buyer_id = users.id
  WHERE items.seller_id = ? AND (item_questions.answer IS NULL OR item_questions.answer = '')
  ORDER BY item_questions.created_at ASC
`).bind(user.id).all();
const unansweredQuestions = unansweredRes.results || [];
---

<Layout title="Dashboard - buy.escatega">
  <div class="space-y-6 max-w-4xl mx-auto">
    
    <!-- User Profile Header -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
      <h1 class="text-2xl font-bold text-eg-black mb-1">
        Welcome back, <span class="text-eg-orange">{user.name}</span>!
      </h1>
      <p class="text-sm text-eg-gray mb-4">Manage your account, active listings, buyer notifications, and questions.</p>

      {statusMessage && <div class="bg-green-100 text-green-800 p-3 rounded-lg text-sm mb-4 border border-green-200">{statusMessage}</div>}
      {errorMessage && <div class="bg-red-100 text-red-800 p-3 rounded-lg text-sm mb-4 border border-red-200">{errorMessage}</div>}

      <div class="bg-eg-light p-4 rounded-lg border border-gray-200 mb-4 space-y-2">
        <p class="text-sm text-eg-gray"><strong>Email:</strong> {user.email}</p>
        <p class="text-sm text-eg-gray"><strong>WhatsApp:</strong> {user.whatsapp_number || 'N/A'}</p>
        <p class="text-sm text-eg-gray"><strong>Role:</strong> <span class="capitalize font-semibold text-eg-black">{user.role}</span></p>
      </div>

      {user.role === 'admin' && (
        <div class="border-t border-gray-200 pt-4">
          <h2 class="text-base font-semibold text-eg-black mb-2">Administrator Tools</h2>
          <a 
            href="/admin/users" 
            class="inline-block bg-eg-black text-white px-4 py-2 rounded-lg text-xs font-bold hover:opacity-90 transition shadow-xs"
          >
            Manage User Approvals
          </a>
        </div>
      )}
    </div>

    <!-- Interested Buyers Notifications Section -->
    {buyerInterests.length > 0 && (
      <div class="bg-white p-6 rounded-xl shadow-sm border border-orange-200 space-y-4">
        <h2 class="text-lg font-bold text-eg-black flex items-center gap-2">
          <span>🛒 Interested Buyers ("I want to buy")</span>
          <span class="bg-eg-orange text-white text-xs px-2.5 py-0.5 rounded-full font-extrabold">{buyerInterests.length}</span>
        </h2>

        <div class="space-y-3">
          {buyerInterests.map((interest: any) => (
            <div class="bg-amber-50/50 p-4 rounded-lg border border-amber-200 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
              <div>
                <p class="text-xs font-bold text-eg-black">
                  {interest.buyer_name} wants to buy: <span class="text-eg-orange">{interest.item_title}</span> (${interest.item_price?.toFixed(2)})
                </p>
                <p class="text-xs text-gray-600 mt-1">
                  Email: {interest.buyer_email} | WhatsApp: <strong>{interest.buyer_whatsapp || 'Not provided'}</strong>
                </p>
              </div>

              {interest.buyer_whatsapp && (
                <a 
                  href={`https://wa.me/${interest.buyer_whatsapp.replace(/[^0-9]/g, '')}?text=Hi%20${encodeURIComponent(interest.buyer_name)},%20I%20saw%20your%20buy%20request%20for%20${encodeURIComponent(interest.item_title)}%20on%20buy.escatega!`} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="bg-green-600 hover:bg-green-700 text-white text-xs px-3.5 py-2 rounded-lg font-bold transition shadow-xs whitespace-nowrap"
                >
                  Contact via WhatsApp
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Unanswered Questions Section -->
    {unansweredQuestions.length > 0 && (
      <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 space-y-4">
        <h2 class="text-lg font-bold text-eg-black flex items-center gap-2">
          <span>💬 Unanswered Buyer Questions</span>
          <span class="bg-eg-orange text-white text-xs px-2.5 py-0.5 rounded-full font-extrabold">{unansweredQuestions.length}</span>
        </h2>

        <div class="space-y-3">
          {unansweredQuestions.map((q: any) => (
            <div class="bg-eg-light p-4 rounded-lg border border-gray-200 space-y-2">
              <p class="text-xs text-eg-gray">On Item: <span class="font-semibold text-eg-black">{q.item_title}</span> | Asked by: <span class="font-semibold text-eg-black">{q.buyer_name}</span></p>
              <p class="text-sm font-medium text-eg-black">"{q.question}"</p>
              
              <form method="POST" class="flex gap-2 pt-1">
                <input type="hidden" name="action" value="answer_question" />
                <input type="hidden" name="question_id" value={q.id} />
                <input type="text" name="answer" required placeholder="Write your reply..." class="flex-grow border p-2 rounded-md text-xs outline-none focus:ring-2 focus:ring-eg-orange bg-white" />
                <button type="submit" class="bg-eg-black text-white px-4 py-1.5 rounded-md text-xs font-bold hover:opacity-90 transition">
                  Reply
                </button>
              </form>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- My Listings Section -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 space-y-4">
      <div class="flex justify-between items-center">
        <h2 class="text-lg font-bold text-eg-black">My Listings ({myItems.length})</h2>
        <a href="/items/create" class="text-xs text-eg-orange font-bold hover:underline">+ Post New Item</a>
      </div>

      {myItems.length === 0 ? (
        <p class="text-sm text-eg-gray italic">You have not posted any items yet.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="border-b border-gray-200 bg-eg-light text-eg-gray text-xs">
                <th class="p-3">Title</th>
                <th class="p-3">Price</th>
                <th class="p-3">Status</th>
                <th class="p-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              {myItems.map((item: any) => (
                <tr class="border-b border-gray-100 hover:bg-gray-50">
                  <td class="p-3 font-semibold text-eg-black">{item.title}</td>
                  <td class="p-3 font-extrabold text-eg-orange">${item.price.toFixed(2)}</td>
                  <td class="p-3">
                    <span class={`capitalize text-[10px] font-extrabold px-2 py-0.5 rounded ${item.status === 'sold' ? 'bg-red-100 text-red-700 border border-red-200' : 'bg-green-100 text-green-800 border border-green-200'}`}>
                      {item.status}
                    </span>
                  </td>
                  <td class="p-3 text-right">
                    <div class="inline-flex space-x-2">
                      {item.status === 'active' && (
                        <form method="POST" style="display: inline;">
                          <input type="hidden" name="action" value="mark_sold" />
                          <input type="hidden" name="item_id" value={item.id} />
                          <button type="submit" class="bg-green-600 text-white px-2.5 py-1 rounded text-xs font-bold hover:bg-green-700 transition">
                            Mark as Sold
                          </button>
                        </form>
                      )}
                      <a 
                        href={`/items/edit?id=${item.id}`} 
                        class="bg-eg-black text-white px-2.5 py-1 rounded text-xs font-bold hover:opacity-90 transition"
                      >
                        Edit
                      </a>
                      <form method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this listing?');">
                        <input type="hidden" name="action" value="delete_item" />
                        <input type="hidden" name="item_id" value={item.id} />
                        <button type="submit" class="bg-red-600 text-white px-2.5 py-1 rounded text-xs font-bold hover:bg-red-700 transition">
                          Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

  </div>
</Layout>