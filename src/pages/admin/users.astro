---
import Layout from '../../layouts/Layout.astro';
import { env } from "cloudflare:workers";

const userId = Astro.cookies.get('user_session')?.value;
const db = env.DB;

// Verify user is logged in and is an Admin
if (!userId) {
  return Astro.redirect('/login');
}

const currentUser = await db.prepare("SELECT * FROM users WHERE id = ?").bind(userId).first();

if (!currentUser || currentUser.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

let statusMessage = '';

// Handle POST actions for Approve, Revoke, or Decline
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action')?.toString();
    const targetUserId = data.get('user_id')?.toString();

    if (action === 'approve' && targetUserId) {
      await db.prepare("UPDATE users SET is_approved = 1 WHERE id = ?").bind(targetUserId).run();
      statusMessage = 'User approved successfully!';
    } else if (action === 'revoke' && targetUserId) {
      await db.prepare("UPDATE users SET is_approved = 0 WHERE id = ? AND role != 'admin'").bind(targetUserId).run();
      statusMessage = 'User access revoked.';
    } else if (action === 'decline' && targetUserId) {
      await db.prepare("DELETE FROM users WHERE id = ? AND role != 'admin'").bind(targetUserId).run();
      statusMessage = 'User application removed.';
    }
  } catch (e) {
    console.error(e);
    statusMessage = 'An error occurred while updating user status.';
  }
}

// Fetch pending and approved users
const pendingUsersRes = await db.prepare("SELECT * FROM users WHERE is_approved = 0 ORDER BY created_at DESC").all();
const approvedUsersRes = await db.prepare("SELECT * FROM users WHERE is_approved = 1 ORDER BY created_at DESC").all();

const pendingUsers = pendingUsersRes.results || [];
const approvedUsers = approvedUsersRes.results || [];
---

<Layout title="User Management - buy.escatega">
  <div class="space-y-6 max-w-4xl mx-auto">
    <div class="flex justify-between items-center">
      <h1 class="text-2xl font-bold text-eg-black">User Management</h1>
      <a href="/dashboard" class="text-sm text-eg-gray hover:text-eg-orange transition">← Back to Dashboard</a>
    </div>

    {statusMessage && (
      <div class="bg-green-100 text-green-800 p-3 rounded text-sm border border-green-200">
        {statusMessage}
      </div>
    )}

    <!-- Pending Approvals Section -->
    <div class="bg-white p-6 rounded-lg shadow border border-gray-200">
      <h2 class="text-lg font-bold text-eg-black mb-4 flex items-center gap-2">
        Pending Approvals
        <span class="bg-eg-orange text-white text-xs px-2 py-0.5 rounded-full">{pendingUsers.length}</span>
      </h2>

      {pendingUsers.length === 0 ? (
        <p class="text-sm text-eg-gray italic">No pending user registrations.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="border-b border-gray-200 bg-eg-light text-eg-gray">
                <th class="p-3">Name</th>
                <th class="p-3">Email</th>
                <th class="p-3">WhatsApp</th>
                <th class="p-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              {pendingUsers.map((u: any) => (
                <tr class="border-b border-gray-100 hover:bg-gray-50">
                  <td class="p-3 font-semibold text-eg-black">{u.name}</td>
                  <td class="p-3 text-eg-gray">{u.email}</td>
                  <td class="p-3 text-eg-gray">{u.whatsapp_number || 'N/A'}</td>
                  <td class="p-3 text-right">
                    <form method="POST" style="display: inline-flex; gap: 0.5rem;">
                      <input type="hidden" name="user_id" value={u.id} />
                      <button 
                        type="submit" 
                        name="action" 
                        value="approve" 
                        class="bg-green-600 text-white px-3 py-1 rounded text-xs font-semibold hover:bg-green-700 transition"
                      >
                        Approve
                      </button>
                      <button 
                        type="submit" 
                        name="action" 
                        value="decline" 
                        class="bg-red-600 text-white px-3 py-1 rounded text-xs font-semibold hover:bg-red-700 transition"
                      >
                        Decline
                      </button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <!-- Approved Members Section -->
    <div class="bg-white p-6 rounded-lg shadow border border-gray-200">
      <h2 class="text-lg font-bold text-eg-black mb-4">Approved Members</h2>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm border-collapse">
          <thead>
            <tr class="border-b border-gray-200 bg-eg-light text-eg-gray">
              <th class="p-3">Name</th>
              <th class="p-3">Email</th>
              <th class="p-3">WhatsApp</th>
              <th class="p-3">Role</th>
              <th class="p-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            {approvedUsers.map((u: any) => (
              <tr class="border-b border-gray-100 hover:bg-gray-50">
                <td class="p-3 font-semibold text-eg-black">{u.name}</td>
                <td class="p-3 text-eg-gray">{u.email}</td>
                <td class="p-3 text-eg-gray">{u.whatsapp_number || 'N/A'}</td>
                <td class="p-3">
                  <span class={`capitalize text-xs font-semibold px-2 py-0.5 rounded ${u.role === 'admin' ? 'bg-eg-black text-white' : 'bg-gray-200 text-gray-800'}`}>
                    {u.role}
                  </span>
                </td>
                <td class="p-3 text-right">
                  {u.role !== 'admin' ? (
                    <form method="POST" style="display: inline-flex; gap: 0.5rem;">
                      <input type="hidden" name="user_id" value={u.id} />
                      <button 
                        type="submit" 
                        name="action" 
                        value="revoke" 
                        class="bg-amber-600 text-white px-3 py-1 rounded text-xs font-semibold hover:bg-amber-700 transition"
                      >
                        Revoke Access
                      </button>
                      <button 
                        type="submit" 
                        name="action" 
                        value="decline" 
                        class="bg-red-600 text-white px-3 py-1 rounded text-xs font-semibold hover:bg-red-700 transition"
                      >
                        Remove
                      </button>
                    </form>
                  ) : (
                    <span class="text-xs text-eg-gray italic">Admin (Protected)</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>