---
import Layout from '../layouts/Layout.astro';
import { env } from "cloudflare:workers";

const userId = Astro.cookies.get('user_session')?.value;
const db = env.DB;

let currentUser = null;
let statusMessage = '';
let errorMessage = '';

if (userId) {
  try {
    currentUser = await db.prepare("SELECT * FROM users WHERE id = ?").bind(userId).first();
  } catch (e) {
    console.error(e);
  }
}

// Read Filter Parameters from URL (e.g. /?category=Electronics&status=active)
const url = new URL(Astro.request.url);
const selectedCategory = url.searchParams.get('category') || 'All';
const selectedStatus = url.searchParams.get('status') || 'active';

// Handle Form Submissions (Buy Request & Q&A)
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('form_action')?.toString();

    // 1. "I want to buy" submission
    if (action === 'request_buy' && currentUser && currentUser.is_approved === 1) {
      const itemId = data.get('item_id')?.toString();
      const sellerId = data.get('seller_id')?.toString();

      if (itemId && sellerId) {
        const existing = await db.prepare("SELECT id FROM item_interests WHERE item_id = ? AND buyer_id = ?").bind(itemId, currentUser.id).first();

        if (existing) {
          statusMessage = 'You have already expressed interest in buying this item! The seller will contact you shortly.';
        } else {
          const interestId = crypto.randomUUID();
          await db.prepare(`
            INSERT INTO item_interests (id, item_id, buyer_id, seller_id)
            VALUES (?, ?, ?, ?)
          `).bind(interestId, itemId, currentUser.id, sellerId).run();

          statusMessage = 'Request sent! The seller has been notified and will contact you shortly via WhatsApp.';
        }
      }
    }

    // 2. Q&A submission
    if (action === 'ask_question' && currentUser && currentUser.is_approved === 1) {
      const itemId = data.get('item_id')?.toString();
      const question = data.get('question')?.toString().trim();

      if (itemId && question) {
        const qId = crypto.randomUUID();
        await db.prepare(`
          INSERT INTO item_questions (id, item_id, buyer_id, question)
          VALUES (?, ?, ?, ?)
        `).bind(qId, itemId, currentUser.id, question).run();
        statusMessage = 'Your question has been posted to the seller!';
      }
    }
  } catch (err) {
    console.error(err);
    errorMessage = 'An error occurred. Please try again.';
  }
}

// Construct SQL Query based on Category and Status filters
let query = `
  SELECT items.*, users.name as seller_name 
  FROM items 
  JOIN users ON items.seller_id = users.id 
  WHERE 1=1
`;
const queryParams: any[] = [];

if (selectedCategory !== 'All') {
  query += ` AND items.category = ?`;
  queryParams.push(selectedCategory);
}

if (selectedStatus === 'active') {
  query += ` AND items.status = 'active'`;
} else if (selectedStatus === 'sold') {
  query += ` AND items.status = 'sold'`;
}

query += ` ORDER BY items.created_at DESC`;

const itemsResult = await db.prepare(query).bind(...queryParams).all();
const items = itemsResult.results || [];

// Fetch all questions
const questionsResult = await db.prepare(`
  SELECT item_questions.*, users.name as buyer_name 
  FROM item_questions 
  JOIN users ON item_questions.buyer_id = users.id 
  ORDER BY item_questions.created_at ASC
`).all();

const allQuestions = questionsResult.results || [];
const categories = ['All', 'Clothing', 'Home', 'Electronics', 'Other'];
---

<Layout title="Catalog - buy.escatega">
  <div class="space-y-6">
    
    <!-- Hero / Header -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h1 class="text-2xl font-extrabold text-eg-black tracking-tight">
          Community <span class="text-eg-orange">Marketplace</span>
        </h1>
        <p class="text-eg-gray text-xs mt-1">Verified community listings & consignment items</p>
      </div>

      {currentUser && currentUser.is_approved === 1 && (
        <a 
          href="/items/create" 
          class="bg-eg-orange text-white px-5 py-2.5 rounded-lg text-xs font-bold hover:bg-orange-600 transition shadow-sm flex items-center gap-1.5"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Post New Item
        </a>
      )}
    </div>

    {statusMessage && <div class="bg-green-100 text-green-800 p-3.5 rounded-xl text-xs font-medium border border-green-200 shadow-2xs">{statusMessage}</div>}
    {errorMessage && <div class="bg-red-100 text-red-800 p-3.5 rounded-xl text-xs font-medium border border-red-200 shadow-2xs">{errorMessage}</div>}

    <!-- Filter Bar (Categories & Availability) -->
    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 space-y-3">
      
      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold text-eg-black mr-1">Category:</span>
        {categories.map((cat) => {
          const isActive = selectedCategory === cat;
          return (
            <a 
              href={`/?category=${cat}&status=${selectedStatus}`}
              class={`text-xs px-3 py-1.5 rounded-lg font-bold transition ${
                isActive 
                  ? 'bg-eg-black text-white shadow-xs' 
                  : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
              }`}
            >
              {cat}
            </a>
          );
        })}
      </div>

      <!-- Status Availability Pills -->
      <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-gray-100">
        <span class="text-xs font-bold text-eg-black mr-1">Status:</span>
        <a 
          href={`/?category=${selectedCategory}&status=active`}
          class={`text-xs px-3 py-1.5 rounded-lg font-bold transition ${
            selectedStatus === 'active' 
              ? 'bg-green-700 text-white shadow-xs' 
              : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
          }`}
        >
          Active Listings
        </a>
        <a 
          href={`/?category=${selectedCategory}&status=sold`}
          class={`text-xs px-3 py-1.5 rounded-lg font-bold transition ${
            selectedStatus === 'sold' 
              ? 'bg-red-600 text-white shadow-xs' 
              : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
          }`}
        >
          Sold Items
        </a>
        <a 
          href={`/?category=${selectedCategory}&status=all`}
          class={`text-xs px-3 py-1.5 rounded-lg font-bold transition ${
            selectedStatus === 'all' 
              ? 'bg-eg-orange text-white shadow-xs' 
              : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
          }`}
        >
          All Items
        </a>
      </div>
    </div>

    <!-- Item Cards Grid -->
    {items.length === 0 ? (
      <div class="bg-white p-12 rounded-xl shadow-sm border border-gray-200 text-center">
        <p class="text-eg-gray italic text-sm">No items found matching your filters.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {items.map((item: any) => {
          const itemQuestions = allQuestions.filter((q: any) => q.item_id === item.id);
          const rawPhotos = [item.photo_1, item.photo_2, item.photo_3].filter(Boolean);
          const photos = rawPhotos.length > 0 ? rawPhotos : ['https://images.unsplash.com/photo-1560343776-97e7d202ff0e?w=800&q=80'];
          const isOwner = currentUser && currentUser.id === item.seller_id;
          const isSold = item.status === 'sold';

          return (
            <div class={`bg-white rounded-xl shadow-sm border border-gray-200 flex flex-col overflow-hidden hover:shadow-md transition-shadow ${isSold ? 'opacity-85' : ''}`}>
              
              <!-- Card Photo Viewer with Sold / Active Overlays -->
              <div class="relative bg-gray-900 aspect-[4/3] w-full overflow-hidden group">
                <img 
                  id={`main-img-${item.id}`} 
                  src={photos[0]} 
                  alt={item.title} 
                  class={`w-full h-full object-cover transition-opacity duration-300 ${isSold ? 'grayscale-25' : ''}`}
                  data-idx="0"
                />

                <!-- Price Badge -->
                <div class="absolute top-3 right-3 bg-eg-black/90 backdrop-blur-sm text-white px-3 py-1 rounded-full shadow-md text-sm font-extrabold border border-gray-700">
                  ${item.price.toFixed(2)}
                </div>

                <!-- Condition / Sold Badge -->
                {isSold ? (
                  <div class="absolute top-3 left-3 bg-red-600 text-white px-3 py-1 rounded-full text-xs font-black uppercase tracking-widest shadow-md border border-red-700">
                    SOLD
                  </div>
                ) : (
                  <div class="absolute top-3 left-3 bg-eg-orange text-white px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider shadow">
                    {item.condition}
                  </div>
                )}

                <!-- Carousel Controls -->
                {photos.length > 1 && (
                  <>
                    <button 
                      type="button"
                      aria-label="Previous image"
                      onclick={`
                        const photos = ${JSON.stringify(photos)};
                        const img = document.getElementById('main-img-${item.id}');
                        let idx = parseInt(img.dataset.idx || '0');
                        idx = (idx - 1 + photos.length) % photos.length;
                        img.src = photos[idx];
                        img.dataset.idx = idx;
                      `}
                      class="absolute left-2 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/80 text-white rounded-full w-8 h-8 flex items-center justify-center text-xs transition"
                    >
                      ❮
                    </button>

                    <button 
                      type="button"
                      aria-label="Next image"
                      onclick={`
                        const photos = ${JSON.stringify(photos)};
                        const img = document.getElementById('main-img-${item.id}');
                        let idx = parseInt(img.dataset.idx || '0');
                        idx = (idx + 1) % photos.length;
                        img.src = photos[idx];
                        img.dataset.idx = idx;
                      `}
                      class="absolute right-2 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/80 text-white rounded-full w-8 h-8 flex items-center justify-center text-xs transition"
                    >
                      ❯
                    </button>
                  </>
                )}
              </div>

              <!-- Thumbnails Bar -->
              {photos.length > 1 && (
                <div class="flex gap-2 p-2 bg-gray-50 border-b border-gray-100 justify-center">
                  {photos.map((pUrl: string, pIdx: number) => (
                    <button 
                      type="button"
                      onclick={`
                        const img = document.getElementById('main-img-${item.id}');
                        img.src = "${pUrl}";
                        img.dataset.idx = "${pIdx}";
                      `}
                      class="w-12 h-10 rounded overflow-hidden border border-gray-300 hover:border-eg-orange transition"
                    >
                      <img src={pUrl} alt="" class="w-full h-full object-cover" />
                    </button>
                  ))}
                </div>
              )}

              <!-- Content Body -->
              <div class="p-4 flex-grow space-y-3">
                <div class="flex justify-between items-start gap-2">
                  <h3 class="text-base font-bold text-eg-black leading-snug line-clamp-1">{item.title}</h3>
                  <span class="text-[10px] font-semibold text-gray-500 bg-gray-100 px-2 py-0.5 rounded whitespace-nowrap">
                    {item.negotiable === 1 ? 'Negotiable' : 'Fixed'}
                  </span>
                </div>

                <div class="flex items-center justify-between text-xs text-eg-gray border-b border-gray-100 pb-2">
                  <span>Category: <strong class="text-eg-black">{item.category}</strong></span>
                  <span>Seller: <strong class="text-eg-black">{item.seller_name}</strong></span>
                </div>

                <p class="text-xs text-gray-600 line-clamp-3 leading-relaxed">
                  {item.description}
                </p>

                <!-- Buy Action Button / Status Badge -->
                {isSold ? (
                  <div class="w-full bg-gray-200 text-gray-700 py-2 rounded-lg text-xs font-bold text-center uppercase tracking-wider">
                    Item Sold Out
                  </div>
                ) : currentUser && currentUser.is_approved === 1 ? (
                  !isOwner ? (
                    <form method="POST">
                      <input type="hidden" name="form_action" value="request_buy" />
                      <input type="hidden" name="item_id" value={item.id} />
                      <input type="hidden" name="seller_id" value={item.seller_id} />
                      <button 
                        type="submit"
                        class="w-full bg-eg-orange hover:bg-orange-600 text-white py-2 rounded-lg text-xs font-bold transition shadow-sm"
                      >
                        I want to buy
                      </button>
                    </form>
                  ) : (
                    <p class="text-[11px] text-gray-400 font-semibold text-center py-1.5 bg-gray-100 rounded-lg">Your Listing</p>
                  )
                ) : (
                  <p class="text-[11px] text-eg-gray italic text-center py-1">Log in as an approved user to buy this item.</p>
                )}
              </div>

              <!-- Collapsible Q&A Section -->
              <div class="border-t border-gray-200 bg-gray-50">
                <details class="group">
                  <summary class="flex justify-between items-center p-3 text-xs font-bold text-eg-black cursor-pointer select-none">
                    <span class="flex items-center gap-1.5">
                      💬 Q&A ({itemQuestions.length})
                    </span>
                    <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
                  </summary>

                  <div class="p-3 pt-0 space-y-3">
                    {itemQuestions.length === 0 ? (
                      <p class="text-[11px] text-eg-gray italic">No questions asked yet.</p>
                    ) : (
                      <div class="space-y-2 max-h-36 overflow-y-auto pr-1">
                        {itemQuestions.map((q: any) => (
                          <div class="bg-white p-2.5 rounded-md text-xs space-y-1 border border-gray-200 shadow-2xs">
                            <p class="text-eg-black font-semibold">Q ({q.buyer_name}): <span class="font-normal text-gray-700">{q.question}</span></p>
                            {q.answer ? (
                              <p class="text-eg-orange font-semibold pl-2.5 border-l-2 border-eg-orange">A: <span class="font-normal text-gray-800">{q.answer}</span></p>
                            ) : (
                              <p class="text-gray-400 italic text-[11px] pl-2.5">Awaiting seller reply...</p>
                            )}
                          </div>
                        ))}
                      </div>
                    )}

                    {!isSold && currentUser && currentUser.is_approved === 1 ? (
                      <form method="POST" class="flex gap-1.5 pt-1">
                        <input type="hidden" name="form_action" value="ask_question" />
                        <input type="hidden" name="item_id" value={item.id} />
                        <input 
                          type="text" 
                          name="question" 
                          required 
                          placeholder="Ask a question..." 
                          class="flex-grow border border-gray-300 p-1.5 rounded-md text-xs outline-none focus:ring-1 focus:ring-eg-orange bg-white" 
                        />
                        <button type="submit" class="bg-eg-black text-white px-3 py-1.5 rounded-md text-xs font-bold hover:opacity-90 transition">
                          Ask
                        </button>
                      </form>
                    ) : isSold ? (
                      <p class="text-[10px] text-eg-gray italic text-center pt-1">This item has been sold.</p>
                    ) : (
                      <p class="text-[10px] text-eg-gray italic text-center pt-1">Log in as an approved user to ask questions.</p>
                    )}
                  </div>
                </details>
              </div>

            </div>
          );
        })}
      </div>
    )}

  </div>
</Layout>