---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { env } from "cloudflare:workers";

const userId = Astro.cookies.get('user_session')?.value;
const db = env.DB;

if (!userId) {
  return Astro.redirect('/login');
}

const currentUser = await db.prepare("SELECT * FROM users WHERE id = ?").bind(userId).first();
if (!currentUser || currentUser.is_approved !== 1) {
  return Astro.redirect('/dashboard');
}

const url = new URL(Astro.request.url);
const itemId = url.searchParams.get('id');

if (!itemId) {
  return Astro.redirect('/dashboard');
}

let item = null;
if (currentUser.role === 'admin') {
  item = await db.prepare("SELECT * FROM items WHERE id = ?").bind(itemId).first();
} else {
  item = await db.prepare("SELECT * FROM items WHERE id = ? AND seller_id = ?").bind(itemId, currentUser.id).first();
}

if (!item) {
  return Astro.redirect('/dashboard');
}

let statusMessage = '';
let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const title = data.get('title')?.toString().trim();
    const description = data.get('description')?.toString().trim();
    const category = data.get('category')?.toString();
    const condition = data.get('condition')?.toString();
    const price = parseFloat(data.get('price')?.toString() || '0');
    const negotiable = data.get('negotiable') === '1' ? 1 : 0;
    
    const photo_1 = data.get('photo_1_input')?.toString().trim() || item.photo_1;
    const photo_2 = data.get('photo_2_input')?.toString().trim() || item.photo_2;
    const photo_3 = data.get('photo_3_input')?.toString().trim() || item.photo_3;

    if (!title || !description || !category || !condition || isNaN(price)) {
      errorMessage = 'Please fill in all required fields.';
    } else {
      await db.prepare(`
        UPDATE items 
        SET title = ?, description = ?, category = ?, condition = ?, price = ?, negotiable = ?, photo_1 = ?, photo_2 = ?, photo_3 = ?
        WHERE id = ?
      `).bind(title, description, category, condition, price, negotiable, photo_1, photo_2, photo_3, itemId).run();

      statusMessage = 'Listing updated successfully!';
      item = await db.prepare("SELECT * FROM items WHERE id = ?").bind(itemId).first();
    }
  } catch (err) {
    console.error(err);
    errorMessage = 'An error occurred while updating the listing.';
  }
}
---

<Layout title="Edit Listing - buy.escatega">
  <div class="space-y-6 max-w-2xl mx-auto">
    <div class="flex justify-between items-center">
      <h1 class="text-2xl font-bold text-eg-black">Edit Listing</h1>
      <a href="/dashboard" class="text-sm text-eg-gray hover:text-eg-orange transition">← Back to Dashboard</a>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
      {statusMessage && <div class="bg-green-100 text-green-800 p-3 rounded-lg text-sm mb-4 border border-green-200">{statusMessage}</div>}
      {errorMessage && <div class="bg-red-100 text-red-800 p-3 rounded-lg text-sm mb-4 border border-red-200">{errorMessage}</div>}

      <form method="POST" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-eg-gray mb-1">Item Title *</label>
            <input type="text" name="title" value={item.title} required class="w-full border border-gray-300 p-2 rounded-lg text-sm outline-none focus:ring-2 focus:ring-eg-orange" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-eg-gray mb-1">Price ($ USD) *</label>
            <input type="number" step="0.01" name="price" value={item.price} required class="w-full border border-gray-300 p-2 rounded-lg text-sm outline-none focus:ring-2 focus:ring-eg-orange" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-eg-gray mb-1">Category *</label>
            <select name="category" required class="w-full border border-gray-300 p-2 rounded-lg text-sm outline-none focus:ring-2 focus:ring-eg-orange bg-white">
              <option value="Clothing" selected={item.category === 'Clothing'}>Clothing</option>
              <option value="Home" selected={item.category === 'Home'}>Home</option>
              <option value="Electronics" selected={item.category === 'Electronics'}>Electronics</option>
              <option value="Other" selected={item.category === 'Other'}>Other</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-eg-gray mb-1">Condition *</label>
            <select name="condition" required class="w-full border border-gray-300 p-2 rounded-lg text-sm outline-none focus:ring-2 focus:ring-eg-orange bg-white">
              <option value="Used" selected={item.condition === 'Used'}>Used</option>
              <option value="New" selected={item.condition === 'New'}>New</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-eg-gray mb-1">Open to Negotiation? *</label>
            <select name="negotiable" required class="w-full border border-gray-300 p-2 rounded-lg text-sm outline-none focus:ring-2 focus:ring-eg-orange bg-white">
              <option value="1" selected={item.negotiable === 1}>Yes</option>
              <option value="0" selected={item.negotiable === 0}>No (Fixed Price)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-eg-gray mb-1">Item Description *</label>
          <textarea name="description" required rows="4" class="w-full border border-gray-300 p-2 rounded-lg text-sm outline-none focus:ring-2 focus:ring-eg-orange">{item.description}</textarea>
        </div>

        <!-- Photo Upload / URL Inputs -->
        <div class="space-y-4 pt-2 border-t border-gray-100">
          <label class="block text-xs font-bold text-eg-black uppercase tracking-wider">Product Photos</label>
          
          <!-- Photo 1 -->
          <div class="bg-gray-50 p-3 rounded-lg border border-gray-200 space-y-2">
            <span class="text-xs font-bold text-gray-700">Photo 1</span>
            <div class="flex flex-col sm:flex-row gap-2">
              <input type="file" accept="image/*" onchange="handleImageUpload(event, 'photo_1_input', 'preview_1')" class="text-xs text-gray-500 file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-bold file:bg-eg-black file:text-white hover:file:opacity-90 cursor-pointer" />
              <input type="url" id="url_1" placeholder="Or paste image URL" oninput="document.getElementById('photo_1_input').value = this.value; document.getElementById('preview_1').src = this.value;" class="flex-grow border border-gray-300 p-1.5 rounded text-xs outline-none bg-white" />
            </div>
            <input type="hidden" name="photo_1_input" id="photo_1_input" value={item.photo_1 || ''} />
            <img id="preview_1" src={item.photo_1 || ''} class={`w-20 h-20 object-cover rounded border border-gray-300 mt-1 ${!item.photo_1 ? 'hidden' : ''}`} alt="Preview 1" />
          </div>

          <!-- Photo 2 -->
          <div class="bg-gray-50 p-3 rounded-lg border border-gray-200 space-y-2">
            <span class="text-xs font-bold text-gray-700">Photo 2</span>
            <div class="flex flex-col sm:flex-row gap-2">
              <input type="file" accept="image/*" onchange="handleImageUpload(event, 'photo_2_input', 'preview_2')" class="text-xs text-gray-500 file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-bold file:bg-eg-black file:text-white hover:file:opacity-90 cursor-pointer" />
              <input type="url" id="url_2" placeholder="Or paste image URL" oninput="document.getElementById('photo_2_input').value = this.value; document.getElementById('preview_2').src = this.value;" class="flex-grow border border-gray-300 p-1.5 rounded text-xs outline-none bg-white" />
            </div>
            <input type="hidden" name="photo_2_input" id="photo_2_input" value={item.photo_2 || ''} />
            <img id="preview_2" src={item.photo_2 || ''} class={`w-20 h-20 object-cover rounded border border-gray-300 mt-1 ${!item.photo_2 ? 'hidden' : ''}`} alt="Preview 2" />
          </div>

          <!-- Photo 3 -->
          <div class="bg-gray-50 p-3 rounded-lg border border-gray-200 space-y-2">
            <span class="text-xs font-bold text-gray-700">Photo 3</span>
            <div class="flex flex-col sm:flex-row gap-2">
              <input type="file" accept="image/*" onchange="handleImageUpload(event, 'photo_3_input', 'preview_3')" class="text-xs text-gray-500 file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-bold file:bg-eg-black file:text-white hover:file:opacity-90 cursor-pointer" />
              <input type="url" id="url_3" placeholder="Or paste image URL" oninput="document.getElementById('photo_3_input').value = this.value; document.getElementById('preview_3').src = this.value;" class="flex-grow border border-gray-300 p-1.5 rounded text-xs outline-none bg-white" />
            </div>
            <input type="hidden" name="photo_3_input" id="photo_3_input" value={item.photo_3 || ''} />
            <img id="preview_3" src={item.photo_3 || ''} class={`w-20 h-20 object-cover rounded border border-gray-300 mt-1 ${!item.photo_3 ? 'hidden' : ''}`} alt="Preview 3" />
          </div>
        </div>

        <div class="flex space-x-3 pt-4">
          <button type="submit" class="bg-eg-orange text-white px-6 py-2.5 rounded-lg font-bold text-sm hover:bg-orange-600 transition shadow-sm">
            Save Changes
          </button>
          <a href="/dashboard" class="bg-gray-200 text-gray-800 px-4 py-2.5 rounded-lg font-bold text-sm hover:bg-gray-300 transition">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    function handleImageUpload(event, hiddenInputId, previewImgId) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          const canvas = document.createElement('canvas');
          const MAX_WIDTH = 800;
          const MAX_HEIGHT = 800;
          let width = img.width;
          let height = img.height;

          if (width > height) {
            if (width > MAX_WIDTH) {
              height *= MAX_WIDTH / width;
              width = MAX_WIDTH;
            }
          } else {
            if (height > MAX_HEIGHT) {
              width *= MAX_HEIGHT / height;
              height = MAX_HEIGHT;
            }
          }

          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);

          const dataUrl = canvas.toDataURL('image/jpeg', 0.7);
          
          document.getElementById(hiddenInputId).value = dataUrl;
          
          const preview = document.getElementById(previewImgId);
          preview.src = dataUrl;
          preview.classList.remove('hidden');
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }
  </script>
</Layout>