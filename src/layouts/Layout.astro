---
import '../styles/global.css'; // <-- Import global CSS here!
import { env } from "cloudflare:workers";

interface Props {
  title?: string;
}

const { title = 'buy.escatega' } = Astro.props;

const userId = Astro.cookies.get('user_session')?.value;
let currentUser = null;

if (userId) {
  try {
    const db = env.DB;
    currentUser = await db.prepare("SELECT * FROM users WHERE id = ?").bind(userId).first();
  } catch (e) {
    console.error(e);
  }
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              'eg-black': '#111111',
              'eg-orange': '#ff6b35',
              'eg-gray': '#555555',
              'eg-light': '#f8f9fa',
            },
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
            }
          }
        }
      }
    </script>

    <!-- Custom CSS Base Reset -->
    <style is:global>
      *, ::before, ::after {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: 'Inter', sans-serif;
        background-color: #f8f9fa;
        color: #111111;
        -webkit-font-smoothing: antialiased;
      }
      /* Custom scrollbar styling for Q&A container */
      ::-webkit-scrollbar {
        width: 6px;
      }
      ::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb {
        background: #ccc;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #ff6b35;
      }
    </style>
  </head>
  <body class="bg-eg-light text-eg-black min-h-screen flex flex-col font-sans">
    
    <!-- Top Navigation Header -->
    <header class="bg-eg-black text-white border-b-4 border-eg-orange sticky top-0 z-50 shadow-md">
      <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
        
        <!-- Logo / Brand -->
        <a href="/" class="text-xl font-extrabold tracking-wide flex items-center gap-1 hover:opacity-90 transition">
          buy.<span class="text-eg-orange">escatega</span>
        </a>

        <!-- Navigation Links -->
        <nav class="flex items-center space-x-4 text-sm font-semibold">
          <a href="/" class="hover:text-eg-orange transition">Catalog</a>

          {currentUser ? (
            <>
              {currentUser.is_approved === 1 && (
                <a 
                  href="/items/create" 
                  class="bg-eg-orange text-white px-3 py-1.5 rounded text-xs hover:opacity-90 transition shadow flex items-center gap-1"
                >
                  <span>+ Post Item</span>
                </a>
              )}
              <a href="/dashboard" class="hover:text-eg-orange transition">Dashboard</a>
              {currentUser.role === 'admin' && (
                <a href="/admin/users" class="hover:text-eg-orange transition text-xs bg-gray-800 px-2 py-1 rounded">Admin</a>
              )}
              <a href="/logout" class="text-gray-400 hover:text-white transition">Log Out</a>
            </>
          ) : (
            <>
              <a href="/login" class="hover:text-eg-orange transition">Log In</a>
              <a href="/register" class="bg-eg-orange text-white px-3 py-1.5 rounded text-xs hover:opacity-90 transition shadow">
                Register
              </a>
            </>
          )}
        </nav>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-6xl w-full mx-auto p-4 md:p-6">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-eg-black text-gray-400 py-6 text-center text-xs border-t border-gray-800 mt-8">
      <p>&copy; {new Date().getFullYear()} Escatega Marketplace. All rights reserved.</p>
    </footer>

  </body>
</html>