
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buy-escatega",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buy-escatega-db",
      "database_id": "fbcccd57-2cac-4d21-9121-74eb7bdb29cd"
    }
  ]
}
